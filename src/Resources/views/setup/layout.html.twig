{# Default standalone setup chrome (REQ-UI-001 / REQ-TWIG-001).
   Host apps: set setup.layout_template (global nowo_site_backup_setup_layout_template)
   to a project shell that defines nowo_ui_content / nowo_site_backup_content.
   v1.18+: colours come from the UiKit --nowo-ui-* tokens; block nowo_site_backup_theme_tokens holds the default
   dark palette (override it with host tokens, or empty it). Component CSS lives in setup/_styles.html.twig.
   Chrome blocks: nowo_site_backup_html_lang, nowo_site_backup_html_class, nowo_site_backup_body_class,
   nowo_site_backup_brand, nowo_site_backup_logo (inside the brand line, empty by default). #}
{% set _csp_nonce = app is defined and app and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
<!DOCTYPE html>
<html lang="{% block nowo_site_backup_html_lang %}{{ app is defined and app and app.request ? app.request.locale|default('en') : 'en' }}{% endblock %}" class="nowo-ui-root nowo-site-backup-setup nowo-ui-css-{{ nowo_site_backup_css_framework|default('custom') }}{% block nowo_site_backup_html_class %}{% endblock %}" data-css-framework="{{ nowo_site_backup_css_framework|default('custom') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block nowo_ui_document_title %}{% block nowo_site_backup_title %}{{ 'setup.page_title.wizard'|trans({'%brand%': brandName}, 'NowoSiteBackupBundle') }}{% endblock %}{% endblock %}</title>
    {# Demo root layout: no parent() (full HTML). Pages do not reopen stylesheets/javascripts. #}
    {% block stylesheets %}
        {% block nowo_ui_styles %}
            <link href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}" rel="stylesheet">
            {% block nowo_site_backup_theme_tokens %}
                {# Default dark palette expressed as UiKit tokens. Override this block (or leave it empty)
                   to apply the host palette: everything below reads var(--nowo-ui-*). #}
                <style{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}>
                    :root {
                        --nowo-ui-primary: #38bdf8;
                        --nowo-ui-primary-contrast: #0b1220;
                        --nowo-ui-surface: #111827;
                        --nowo-ui-surface-muted: #0b1220;
                        --nowo-ui-border: #1f2937;
                        --nowo-ui-border-strong: #334155;
                        --nowo-ui-text: #e5e7eb;
                        --nowo-ui-muted: #9ca3af;
                        --nowo-ui-danger: #f87171;
                        --nowo-ui-success-text: #4ade80;
                        --nowo-ui-radius: 8px;
                    }
                </style>
            {% endblock %}
            {% block nowo_site_backup_styles %}
                <style{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}>
                    * { box-sizing: border-box; }
                    body.nowo-ui-body {
                        margin: 0;
                        min-height: 100vh;
                        font-family: system-ui, sans-serif;
                        background:
                            radial-gradient(900px 400px at 10% 0%, color-mix(in srgb, var(--nowo-ui-primary, #38bdf8) 35%, #1d4ed8) 0%, transparent 50%),
                            radial-gradient(700px 400px at 100% 100%, color-mix(in srgb, var(--nowo-ui-primary, #38bdf8) 60%, #0ea5e9) 0%, transparent 45%),
                            var(--nowo-ui-surface-muted, #0b1220);
                        color: var(--nowo-ui-text, #e5e7eb);
                    }
                    .nowo-site-backup-setup .nowo-ui-main,
                    .nowo-ui-main.nowo-site-backup-setup { width: min(640px, 94vw); margin: 4vh auto; }
                </style>
                {{ include('@NowoSiteBackupBundle/setup/_styles.html.twig') }}
            {% endblock %}
        {% endblock %}
    {% endblock %}
</head>
<body class="nowo-ui-body{% block nowo_site_backup_body_class %}{% endblock %}">
<div class="nowo-ui-main nowo-site-backup-setup">
    {% block nowo_site_backup_brand %}
        <div class="brand">{% block nowo_site_backup_logo %}{% endblock %}{{ brandName }}</div>
    {% endblock %}
    {% block nowo_ui_content %}
        {% block nowo_site_backup_content %}{% endblock %}
    {% endblock %}
    {% block nowo_ui_modals %}{% endblock %}
</div>
{% block javascripts %}
    {% block nowo_ui_scripts %}{% endblock %}
{% endblock %}
</body>
</html>
