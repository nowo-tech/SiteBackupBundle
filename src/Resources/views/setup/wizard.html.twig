{#
  Setup wizard (REQ-UI-003, page/wizard on the guest layout). Variable: page (View\WizardPage, built by
  View\SetupPages::wizard): configured steps + a final "done" step, current step from the setup progress.
  Extra context (1.x names, also passed to host step templates): progress (Model\SetupProgress), steps, currentStep,
  reasons (setup need detectors), error, wizardForm (= page.form), advanceMode, progressUrl, pathPrefix, brandName.
  Data block: nowo_ui_wizard_step (UiKit progress partial, reasons, error, the step form, log). No database service is used.
#}
{% extends '@NowoUiKit/page/wizard.html.twig' %}

{% set _sbb_auto_advance = advanceMode|default('automatic') == 'automatic' and progress.phase == 'running' and wizardForm %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {{ include('@NowoSiteBackupBundle/_messages.html.twig') }}
{% endblock %}

{% block nowo_ui_wizard_step %}
    {% set _b = page.bundle %}
    {% set _d = 'NowoSiteBackupBundle' %}
    {#- Progress messages / errors mix translation keys (setup.check.ok, step labels) with literal step output
        ("Migrations applied.", exception messages) and text the controller already translated: only key-shaped
        values are looked up, the rest is printed as given (no "missing message" in the profiler). -#}
    {% set _key = '/^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$/' %}
    {% set _message = progress.message ? (progress.message matches _key ? progress.message|trans({}, _d) : progress.message) : null %}
    {{ include(nowo_ui_partial('progress', _b), {
        percent: progress.percent|round,
        label: _message ?? 'setup.wizard.progress'|trans({}, _d),
        id: 'nowo-sbb-setup-progress',
        attr: {'data-testid': 'nowo-sbb-setup-progress'},
        bundle: _b,
    }) }}

    {% set setup_reasons = reasons|default([]) %}
    {% set db_connection_failed = 'database connection failed' in setup_reasons %}
    {% set db_schema_empty = 'database schema is empty' in setup_reasons %}
    {% if setup_reasons is not empty %}
        <div class="{{ nowo_ui_class('flash_warning', _b) }}" role="status" data-testid="nowo-sbb-setup-reasons"{{ nowo_ui_attrs('flash_warning', _b) }}>
            <strong>{{ 'setup.reason.heading'|trans({}, _d) }}</strong>
            <ul>
                {% for reason in setup_reasons %}
                    <li>
                        {% if reason == 'database connection failed' %}
                            {{ 'setup.reason.db_connection'|trans({}, _d) }}
                        {% elseif reason == 'database schema is empty' %}
                            {{ 'setup.reason.db_schema_empty'|trans({}, _d) }}
                        {% elseif reason == 'setup.required marker present' %}
                            {{ 'setup.reason.marker_required'|trans({}, _d) }}
                        {% elseif reason == 'setup.done marker missing' %}
                            {{ 'setup.reason.marker_done_missing'|trans({}, _d) }}
                        {% elseif reason starts with 'incomplete setup progress' %}
                            {{ 'setup.reason.incomplete'|trans({'%detail%': reason}, _d) }}
                        {% else %}
                            {{ reason }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if db_connection_failed %}
                <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'setup.reason.db_connection_hint'|trans({}, _d) }}</p>
            {% elseif db_schema_empty %}
                <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'setup.reason.db_schema_hint'|trans({}, _d) }}</p>
            {% endif %}
        </div>
    {% endif %}

    {% if error %}
        <div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert"{{ nowo_ui_attrs('flash_error', _b) }}>{{ error matches _key ? error|trans({}, _d) : error }}</div>
    {% elseif progress.error %}
        <div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert"{{ nowo_ui_attrs('flash_error', _b) }}>{{ progress.error matches _key ? progress.error|trans({}, _d) : progress.error }}</div>
    {% endif %}

    {% if wizardForm %}
        {% if progress.phase == 'waiting_input' and currentStep %}
            {% if currentStep.template|default(null) %}
                {{ include(currentStep.template, {form: wizardForm}) }}
            {% elseif 'bootstrap' in currentStep.id %}
                {{ include('@NowoSiteBackupBundle/setup/_bootstrap_form.html.twig', {form: wizardForm}) }}
            {% elseif 'admin' in currentStep.id %}
                {{ include('@NowoSiteBackupBundle/setup/_admin_form.html.twig', {form: wizardForm}) }}
            {% elseif 'sample' in currentStep.id %}
                {{ include('@NowoSiteBackupBundle/setup/_sample_form.html.twig', {form: wizardForm}) }}
            {% elseif 'database_url' in currentStep.id %}
                {{ include('@NowoSiteBackupBundle/setup/_database_form.html.twig', {form: wizardForm, db_connection_failed: db_connection_failed}) }}
            {% else %}
                {{ include('@NowoSiteBackupBundle/setup/_continue_form.html.twig', {form: wizardForm}) }}
            {% endif %}
        {% elseif progress.phase == 'failed' %}
            {{ form_start(wizardForm, {attr: {class: nowo_ui_class('form', _b)}}) }}
                <div class="{{ nowo_ui_class('form_actions', _b) }}">
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'setup.wizard.retry'|trans({}, _d) }}</button>
                </div>
            {{ form_end(wizardForm) }}
        {% else %}
            {{ form_start(wizardForm, {attr: {class: nowo_ui_class('form', _b), id: 'nowo-sbb-auto-advance'}}) }}
                <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'setup.wizard.running'|trans({}, _d) }}</p>
                <div class="{{ nowo_ui_class('form_actions', _b) }}">
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'setup.wizard.continue'|trans({}, _d) }}</button>
                </div>
            {{ form_end(wizardForm) }}
        {% endif %}
    {% endif %}

    {% if progress.log is not empty %}
        <pre class="{{ nowo_ui_class('code_block', _b) }} nowo-sbb-setup__log" data-testid="nowo-sbb-setup-log"{{ nowo_ui_attrs('code_block', _b) }}><code>{{ progress.log|slice(-12)|join(constant('PHP_EOL')) }}</code></pre>
    {% endif %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% if _sbb_auto_advance %}
        {# Automatic advance mode: submit the running step after a short pause (no inline on* handler; CSP nonce). #}
        {% set _csp_nonce = app is defined and app and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
        <script{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}>setTimeout(function () { var f = document.getElementById('nowo-sbb-auto-advance'); if (f) { f.submit(); } }, 600);</script>
    {% endif %}
{% endblock %}
