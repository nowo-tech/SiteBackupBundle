{#
  Setup token gate (REQ-UI-003, page/auth on the guest layout, HTTP 403). Variable: page (View\AuthPage, built by
  View\SetupPages::token): GET form Form\Setup\SetupTokenType (field `token`). Extra context: pathPrefix, brandName.
  Data block: nowo_ui_auth_footer (how to find the token: setup.setup_token, ?token=…, X-Setup-Token).
#}
{% extends '@NowoUiKit/page/auth.html.twig' %}

{% block nowo_ui_auth_footer %}
    {% set _example = pathPrefix ~ '?token=…' %}
    <details class="nowo-sbb-token__howto" data-testid="nowo-sbb-token-howto">
        <summary>{{ 'setup.token.howto'|trans({}, 'NowoSiteBackupBundle') }}</summary>
        <ol>
            <li>{{ 'setup.token.step_env'|trans({}, 'NowoSiteBackupBundle') }}</li>
            <li>{{ 'setup.token.step_url'|trans({'%path%': _example}, 'NowoSiteBackupBundle') }}</li>
            <li>{{ 'setup.token.step_header'|trans({}, 'NowoSiteBackupBundle') }}</li>
        </ol>
    </details>
{% endblock %}
