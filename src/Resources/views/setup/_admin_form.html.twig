{# Admin user step (Form\Setup\AdminUserType: email, password). Variables: form. #}
{% set _b = 'NowoSiteBackupBundle' %}
{{ form_start(form, {attr: {class: nowo_ui_class('form', _b)}}) }}
    {% for child in form %}
        {% if not child.rendered %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
    <div class="{{ nowo_ui_class('form_actions', _b) }}">
        <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'setup.admin.create'|trans({}, _b) }}</button>
    </div>
{{ form_end(form) }}
