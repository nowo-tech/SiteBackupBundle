{{ form_start(form) }}
    <div>
        {{ form_label(form.email, 'Email') }}
        {{ form_widget(form.email, {attr: {autocomplete: 'username'}}) }}
    </div>
    <div>
        {{ form_label(form.password, 'Password') }}
        {{ form_widget(form.password, {attr: {autocomplete: 'new-password'}}) }}
    </div>
    <div class="actions">
        <button type="submit">{{ 'setup.admin.create'|trans({}, 'NowoSiteBackupBundle') }}</button>
    </div>
{{ form_end(form) }}
