<form method="post">
    <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
    <label>Email <input type="email" name="email" required autocomplete="username" value="{{ progress.answers.admin_email|default('') }}"></label>
    <label>Password <input type="password" name="password" required autocomplete="new-password"></label>
    <div class="actions">
        <button type="submit">{{ 'setup.admin.create'|trans({}, 'NowoSiteBackupBundle') }}</button>
    </div>
</form>
