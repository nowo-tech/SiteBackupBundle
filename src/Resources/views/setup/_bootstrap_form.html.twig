{# Bootstrap mode step (Form\Setup\BootstrapModeType: sql_import_path; submit name bootstrap_mode = guided | full_database). Variables: form, progress. #}
{% set _b = 'NowoSiteBackupBundle' %}
{% if progress.phase == 'waiting_input' %}
{{ form_start(form, {attr: {class: nowo_ui_class('form', _b)}}) }}
    <p>{{ 'setup.bootstrap.prompt'|trans({}, _b) }}</p>
    {{ form_row(form.sql_import_path, {attr: {class: nowo_ui_class('input_wide', _b), placeholder: 'var/site-backup/full-import.sql'}}) }}
    {{ form_rest(form) }}
    <div class="{{ nowo_ui_class('form_actions', _b) }}">
        <button type="submit" name="bootstrap_mode" value="guided" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'setup.bootstrap.guided'|trans({}, _b) }}</button>
        <button type="submit" name="bootstrap_mode" value="full_database" class="{{ nowo_ui_class('btn_secondary', _b) }}">{{ 'setup.bootstrap.full_database'|trans({}, _b) }}</button>
    </div>
{{ form_end(form) }}
{% endif %}
