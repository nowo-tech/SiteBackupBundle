{# Setup wizard component styles (v1.18+), driven by the UiKit --nowo-ui-* tokens with inline fallbacks.
   The bundle setup layout includes it; a host layout (setup.layout_template) can include it too so the
   wizard forms / steps / progress bar follow the host tokens without copying CSS:
       {% include '@NowoSiteBackupBundle/setup/_styles.html.twig' %}
   Legacy --nowo-sbb-* variables stay available as aliases of the tokens. #}
{% set _csp_nonce = app is defined and app and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
<style{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}>
    .nowo-site-backup-setup {
        --nowo-sbb-bg: var(--nowo-ui-surface-muted, #0b1220);
        --nowo-sbb-panel: var(--nowo-ui-surface, #111827);
        --nowo-sbb-text: var(--nowo-ui-text, #e5e7eb);
        --nowo-sbb-muted: var(--nowo-ui-muted, #9ca3af);
        --nowo-sbb-accent: var(--nowo-ui-primary, #38bdf8);
        --nowo-sbb-accent-contrast: var(--nowo-ui-primary-contrast, #0b1220);
        --nowo-sbb-border: var(--nowo-ui-border, #1f2937);
        --nowo-sbb-border-strong: var(--nowo-ui-border-strong, #334155);
        --nowo-sbb-radius: var(--nowo-ui-radius, 8px);
        --nowo-sbb-err: var(--nowo-ui-danger, #f87171);
        --nowo-sbb-ok: var(--nowo-ui-success-text, #4ade80);
        --nowo-sbb-warn: var(--nowo-ui-warning, #fbbf24);
    }
    .nowo-site-backup-setup .brand {
        font-size: .85rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--nowo-sbb-accent);
        margin-bottom: .5rem;
    }
    .nowo-site-backup-setup h1 { margin: 0 0 .35rem; font-size: 1.6rem; }
    .nowo-site-backup-setup .sub { color: var(--nowo-sbb-muted); margin: 0 0 1.5rem; }
    .nowo-site-backup-setup .card,
    .nowo-site-backup-setup .nowo-ui-card {
        background: color-mix(in srgb, var(--nowo-sbb-panel) 90%, transparent);
        color: var(--nowo-sbb-text);
        border: 1px solid var(--nowo-sbb-border);
        border-radius: calc(var(--nowo-sbb-radius) * 2);
        padding: 1.5rem;
    }
    .nowo-site-backup-setup .steps { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: 1rem; }
    .nowo-site-backup-setup .steps span {
        font-size: .72rem;
        padding: .2rem .5rem;
        border-radius: 999px;
        background: var(--nowo-sbb-bg);
        color: var(--nowo-sbb-muted);
        border: 1px solid var(--nowo-sbb-border);
    }
    .nowo-site-backup-setup .steps span.on { color: var(--nowo-sbb-text); border-color: var(--nowo-sbb-accent); }
    .nowo-site-backup-setup .steps span.done { color: var(--nowo-sbb-ok); }
    .nowo-site-backup-setup .bar {
        height: 10px;
        background: var(--nowo-sbb-bg);
        border-radius: 999px;
        overflow: hidden;
        margin: 1rem 0;
    }
    .nowo-site-backup-setup .bar > i {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--nowo-sbb-accent), color-mix(in srgb, var(--nowo-sbb-accent) 55%, #818cf8));
    }
    .nowo-site-backup-setup progress.bar {
        display: block;
        width: 100%;
        border: 0;
        appearance: none;
        accent-color: var(--nowo-sbb-accent);
    }
    .nowo-site-backup-setup progress.bar::-webkit-progress-bar { background: var(--nowo-sbb-bg); }
    .nowo-site-backup-setup progress.bar::-webkit-progress-value { background: linear-gradient(90deg, var(--nowo-sbb-accent), color-mix(in srgb, var(--nowo-sbb-accent) 55%, #818cf8)); }
    .nowo-site-backup-setup progress.bar::-moz-progress-bar { background: linear-gradient(90deg, var(--nowo-sbb-accent), color-mix(in srgb, var(--nowo-sbb-accent) 55%, #818cf8)); }
    .nowo-site-backup-setup .sub--hint { margin: .75rem 0 0; }
    .nowo-site-backup-setup .nowo-sbb-center { text-align: center; }
    .nowo-site-backup-setup .err { color: var(--nowo-sbb-err); }
    .nowo-site-backup-setup .warn {
        margin: 0 0 1rem;
        padding: .75rem 1rem;
        border-radius: var(--nowo-sbb-radius);
        border: 1px solid color-mix(in srgb, var(--nowo-sbb-warn) 45%, var(--nowo-sbb-border));
        background: color-mix(in srgb, var(--nowo-sbb-warn) 12%, var(--nowo-sbb-panel));
        color: color-mix(in srgb, var(--nowo-sbb-warn) 55%, var(--nowo-sbb-text));
        font-size: .9rem;
    }
    .nowo-site-backup-setup .warn ul { margin: .5rem 0 0; padding-left: 1.25rem; }
    .nowo-site-backup-setup .log {
        max-height: 160px;
        overflow: auto;
        font-size: .8rem;
        color: var(--nowo-sbb-muted);
        background: var(--nowo-sbb-bg);
        padding: .75rem;
        border-radius: var(--nowo-sbb-radius);
        margin-top: 1rem;
    }
    .nowo-site-backup-setup label {
        display: block;
        margin: .75rem 0 .35rem;
        color: var(--nowo-sbb-muted);
        font-size: .9rem;
    }
    .nowo-site-backup-setup input[type=text],
    .nowo-site-backup-setup input[type=email],
    .nowo-site-backup-setup input[type=password],
    .nowo-site-backup-setup input[type=url] {
        width: 100%;
        padding: .65rem .75rem;
        border-radius: var(--nowo-sbb-radius);
        border: 1px solid var(--nowo-sbb-border-strong);
        background: var(--nowo-sbb-bg);
        color: var(--nowo-sbb-text);
    }
    .nowo-site-backup-setup .actions {
        display: flex;
        gap: .75rem;
        margin-top: 1.25rem;
        flex-wrap: wrap;
    }
    .nowo-site-backup-setup button {
        background: var(--nowo-sbb-accent);
        color: var(--nowo-sbb-accent-contrast);
        border: 0;
        border-radius: var(--nowo-sbb-radius);
        padding: .6rem 1rem;
        font-weight: 600;
        cursor: pointer;
    }
    .nowo-site-backup-setup button.secondary {
        background: transparent;
        color: var(--nowo-sbb-text);
        border: 1px solid var(--nowo-sbb-border-strong);
    }
    .nowo-site-backup-setup .nowo-sbb-token__form { display: flex; gap: .75rem; flex-wrap: wrap; align-items: flex-end; }
    .nowo-site-backup-setup .nowo-sbb-token__form > div { flex: 1 1 16rem; }
    .nowo-site-backup-setup .nowo-sbb-token__howto { margin-top: 1.25rem; color: var(--nowo-sbb-muted); font-size: .9rem; }
    .nowo-site-backup-setup .nowo-sbb-token__howto summary { cursor: pointer; color: var(--nowo-sbb-text); }
</style>
