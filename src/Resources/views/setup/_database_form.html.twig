{% set db_connection_failed = db_connection_failed|default(false) %}
{% if not db_connection_failed and reasons is defined %}
    {% set db_connection_failed = 'database connection failed' in reasons %}
{% endif %}
{% set database_url_optional = database_url_optional|default(true) %}
{% if form.vars.optional is defined %}
    {% set database_url_optional = form.vars.optional %}
{% endif %}

{{ form_start(form) }}
    {% if db_connection_failed %}
        <p class="warn" role="alert">{{ 'setup.reason.db_connection_form'|trans({}, 'NowoSiteBackupBundle') }}</p>
    {% endif %}
    {{ form_label(form.database_url, 'DATABASE_URL', {label_attr: {for: 'nowo-sbb-database-url'}}) }}
    {{ form_widget(form.database_url, {
        id: 'nowo-sbb-database-url',
        attr: {
            autocomplete: 'off',
            placeholder: 'postgresql://user:pass@db:5432/app',
        },
    }) }}
    <div class="actions">
        <button type="submit">{{ 'setup.database.save'|trans({}, 'NowoSiteBackupBundle') }}</button>
        {% if database_url_optional or not db_connection_failed %}
            {# formnovalidate: HTML5 must not block Skip with an empty field #}
            <button class="secondary" type="submit" name="action" value="skip" formnovalidate>{{ 'setup.database.skip'|trans({}, 'NowoSiteBackupBundle') }}</button>
        {% endif %}
    </div>
{{ form_end(form) }}
