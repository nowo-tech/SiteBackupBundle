{% extends nowo_site_backup_panel_layout_template %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _sbb_fw = nowo_site_backup_css_framework|default('custom') %}

{% block nowo_ui_document_title %}Site Backup panel{% endblock %}

{% block nowo_site_backup_panel_content %}
<section class="nowo-ui-card card">
    <h2>Create backup</h2>
    {{ form_start(createForm, {attr: {class: 'nowo-ui-form'}}) }}
        <div>
            {{ form_label(createForm.label, 'Label') }}
            {{ form_widget(createForm.label, {attr: {placeholder: 'pre-deploy'}}) }}
        </div>
        <button type="submit" class="{{ ui.btn('primary', null, _sbb_fw) }} nowo-ui-btn">Create integral backup</button>
    {{ form_end(createForm) }}
</section>

<section class="nowo-ui-card card">
    <h2>Restore progress</h2>
    <p>Phase: <strong>{{ progress.phase }}</strong> - {{ progress.percent|number_format(1) }}%</p>
    <p>{{ progress.message }}</p>
    {% if progress.error %}<p class="nowo-ui-flash nowo-ui-flash--err">{{ progress.error }}</p>{% endif %}
    {% if progress.phase in ['completed', 'failed'] %}
        {{ form_start(clearRestoreForm, {attr: {class: 'nowo-ui-form'}}) }}
            <button type="submit" class="nowo-ui-btn">Clear status</button>
        {{ form_end(clearRestoreForm) }}
    {% endif %}
</section>

<section class="nowo-ui-card card">
    <h2>Archives</h2>
    {% if backups is empty %}
        <p>No backups yet.</p>
    {% else %}
        <table class="nowo-ui-table">
            <thead>
            <tr><th>ID</th><th>Created</th><th>Size</th><th>Label</th><th>Actions</th></tr>
            </thead>
            <tbody>
            {% for b in backups %}
                <tr>
                    <td><code>{{ b.id }}</code></td>
                    <td>{{ b.createdAt|date('Y-m-d H:i') }}</td>
                    <td>{{ b.sizeBytes }}</td>
                    <td>{{ b.label }}</td>
                    <td>
                        {{ form_start(backupForms[b.id].verify, {attr: {class: 'nowo-ui-form--inline inline'}}) }}
                            <button type="submit" class="nowo-ui-btn">Verify</button>
                        {{ form_end(backupForms[b.id].verify) }}
                        {{ form_start(backupForms[b.id].restore, {attr: {class: 'nowo-ui-form--inline inline', onsubmit: "return confirm('Restore this backup now? Visitors will see the loading page.');"}}) }}
                            <button type="submit" class="nowo-ui-btn">Restore</button>
                        {{ form_end(backupForms[b.id].restore) }}
                        {{ form_start(backupForms[b.id].delete, {attr: {class: 'nowo-ui-form--inline inline', onsubmit: "return confirm('Delete backup?');"}}) }}
                            <button class="nowo-ui-btn nowo-ui-btn--danger danger" type="submit">Delete</button>
                        {{ form_end(backupForms[b.id].delete) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>

{{ form_start(logoutForm, {attr: {class: 'nowo-ui-form'}}) }}
    <button type="submit" class="nowo-ui-btn">Logout</button>
{{ form_end(logoutForm) }}
{% endblock %}
