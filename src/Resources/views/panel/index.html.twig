{#
  Backup panel — archives list (REQ-UI-003, page/list). Variable: page (View\ListPage, built by View\PanelPages::index):
  header actions Create backup / Logout, area nav Backups | History, rows = Model\BackupArtifact, row actions Verify,
  Restore (type-to-confirm dialog, no-JS fallback page) and Delete (confirm dialog, no-JS fallback page).
  Extra context: messages (result of the last POST), progress (Model\RestoreProgress), clear_restore (View\Action).
  Data blocks: nowo_ui_list_row; canonical block nowo_ui_flashes (+ messages, restore status).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {{ include('@NowoSiteBackupBundle/_messages.html.twig') }}
    {{ include('@NowoSiteBackupBundle/panel/_restore_status.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'panel.index.col_id'|trans({}, _b) }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.id }}</code></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'panel.index.col_created'|trans({}, _b) }}"><time datetime="{{ row.createdAt|date('c') }}">{{ row.createdAt|date('Y-m-d H:i') }}</time></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }} nowo-ui-cell--end" data-label="{{ 'panel.index.col_size'|trans({}, _b) }}" data-nowo-ui-priority="2" data-bytes="{{ row.sizeBytes }}">{{ row.sizeBytes|number_format(0, '.', ' ') }} B</td>
    {% if row.label %}
        <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'panel.index.col_label'|trans({}, _b) }}" data-nowo-ui-priority="3">{{ row.label }}</td>
    {% else %}
        <td class="{{ nowo_ui_class('table_cell', _b) }} {{ nowo_ui_class('table_cell_muted', _b) }}" data-label="{{ 'panel.index.col_label'|trans({}, _b) }}" data-nowo-ui-priority="3">—</td>
    {% endif %}
{% endblock %}
