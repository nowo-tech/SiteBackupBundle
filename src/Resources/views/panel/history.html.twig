{#
  Backup panel — history (REQ-UI-003, page/list). Variable: page (View\ListPage, built by View\PanelPages::history):
  rows = Model\BackupHistoryEntry (newest first), area nav Backups | History, no row actions.
  Data block: nowo_ui_list_row.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {{ include('@NowoSiteBackupBundle/_messages.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _muted = nowo_ui_class('table_cell', _b) ~ ' ' ~ nowo_ui_class('table_cell_muted', _b) %}
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'panel.history.col_when'|trans({}, _b) }}"><time datetime="{{ row.occurredAt|date('c') }}">{{ row.occurredAt|date('Y-m-d H:i:s') }}</time></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'panel.history.col_action'|trans({}, _b) }}"><span class="{{ nowo_ui_class(row.action in ['delete', 'restore_failed'] ? 'badge_danger' : (row.action starts with 'restore' ? 'badge_warning' : (row.action == 'create' ? 'badge_success' : 'badge_neutral')), _b) }}">{{ row.action }}</span></td>
    <td class="{{ row.backupId ? nowo_ui_class('table_cell', _b) : _muted }}" data-label="{{ 'panel.history.col_backup'|trans({}, _b) }}" data-nowo-ui-priority="2">{% if row.backupId %}<code class="{{ nowo_ui_class('code', _b) }}">{{ row.backupId }}</code>{% else %}—{% endif %}</td>
    <td class="{{ row.actor ? nowo_ui_class('table_cell', _b) : _muted }}" data-label="{{ 'panel.history.col_actor'|trans({}, _b) }}" data-nowo-ui-priority="3">{{ row.actor ?: '—' }}</td>
    <td class="{{ row.message ? nowo_ui_class('table_cell', _b) : _muted }}" data-label="{{ 'panel.history.col_message'|trans({}, _b) }}" data-nowo-ui-priority="3">{{ row.message ?: '—' }}</td>
{% endblock %}
