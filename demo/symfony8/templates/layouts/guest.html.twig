{#
  Demo guest layout (nowo_ui_kit.layouts.guest, REQ-DEMO-014): UiKit's guest layout, default theme. Panel sign-in and
  setup wizard. It renders before the app has a database (setup wizard): no DB-backed Twig here.
#}
{% extends '@NowoUiKit/layout/guest.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{% endblock %} · Site Backup Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% if app.request.pathInfo matches '{_setup}' %}
        {# Built by App\Twig\DemoFormExtension: bundle controllers render this layout, so no demo variable is passed (REQ-TWIG-005). #}
        {% set gate_escape_form = demo_force_setup_off_form() %}
        {{ form_start(gate_escape_form) }}
            {% for child in gate_escape_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
            <span class="nowo-ui-muted">Demo gate escape:</span> <button type="submit" class="nowo-ui-btn nowo-ui-btn--outline">Clear force-setup flag</button>
        {{ form_end(gate_escape_form) }}
    {% endif %}
{% endblock %}
