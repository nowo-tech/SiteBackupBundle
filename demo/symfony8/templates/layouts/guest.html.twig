{#
  Demo guest layout (nowo_ui_kit.layouts.guest, REQ-DEMO-014): the demo platform shell, plus (on the setup wizard) the
  demo gate escape. Panel sign-in and setup wizard. It renders before the app has a database (setup wizard): no
  DB-backed Twig here.
#}
{% extends 'base.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{% endblock %} · Site Backup Demo{% endblock %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {% if app.request.pathInfo matches '{_setup}' %}
        {# Built by App\Twig\DemoFormExtension: bundle controllers render this layout, so no demo variable is passed (REQ-TWIG-005). #}
        {% set gate_escape_form = demo_force_setup_off_form() %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Demo gate escape', kind: 'form', testid: 'demo-gate-escape', gate_escape_form: gate_escape_form} %}
            {% block section_body %}
                {{ form_start(gate_escape_form) }}
                    {% for child in gate_escape_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                    <button type="submit" class="nowo-ui-btn nowo-ui-btn--outline">Clear force-setup flag</button>
                {{ form_end(gate_escape_form) }}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
