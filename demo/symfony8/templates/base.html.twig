{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The Site Backup panel pages render in it too (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Site Backup Bundle demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _path = app.request.pathInfo %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('homepage') }}">Site Backup Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Site Backup Bundle">
            <a class="nowo-ui-link" href="{{ path('homepage') }}"{% if _path == '/' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="/_site_backup"{% if _path starts with '/_site_backup' %} aria-current="page"{% endif %}>Panel</a>
            <a class="nowo-ui-link" href="/en/_setup">Setup</a>
            <a class="nowo-ui-link" href="/es/_setup">Setup (es)</a>
            <a class="nowo-ui-link" href="/health">Health</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
