{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). The Site Backup panel pages render in it too (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Site Backup',
    home_route: 'homepage',
    repository: 'https://github.com/nowo-tech/SiteBackupBundle',
    translation_domain: false,
    locales: [],
    nav: [
        {label: 'Home', route: 'homepage', section: 'Demo'},
        {label: 'Panel', route: 'nowo_site_backup_panel', active: ['nowo_site_backup_panel', 'nowo_site_backup_create', 'nowo_site_backup_restore_confirm', 'nowo_site_backup_delete_confirm', 'nowo_site_backup_history'], section: 'Site Backup'},
        {label: 'Setup', route: 'nowo_site_backup_setup', params: {_locale: 'en'}, section: 'Site Backup', testid: 'demo-nav-setup-en'},
        {label: 'Setup (es)', route: 'nowo_site_backup_setup', params: {_locale: 'es'}, section: 'Site Backup', testid: 'demo-nav-setup-es'},
        {label: 'Setup token gate', route: 'demo_setup_token_gate', section: 'Site Backup'},
        {label: 'Health', href: '/health', active: [], section: 'Site Backup', testid: 'demo-nav-health'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Site Backup Bundle demo{% endblock %}{% endblock %}
