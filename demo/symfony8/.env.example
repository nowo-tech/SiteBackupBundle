APP_ENV=dev
APP_DEBUG=1

# classic | worker — default worker (REQ-DEMO-010). After changing: docker compose up -d
FRANKENPHP_MODE=worker

APP_SECRET=CHANGE_ME_LOCAL_SECRET

# Host port → :80 in the container
PORT=8056
DEFAULT_URI=http://localhost:8056

# MySQL on the compose network (no host ports — REQ-DEMO-006)
DATABASE_URL="mysql://app:app@mysql:3306/site_backup_demo?serverVersion=8.4.0&charset=utf8mb4"
