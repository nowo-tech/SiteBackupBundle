# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev` (Web Profiler, debug toolbar).
APP_ENV=dev
# APP_DEBUG: enable detailed debug output (`1` in dev, `0` in prod).
APP_DEBUG=1

# FRANKENPHP_MODE: classic | worker — default worker (REQ-DEMO-010). After changing: docker compose up -d
FRANKENPHP_MODE=worker

# APP_SECRET: secret used by Symfony for signing (CSRF tokens, signed URLs). Local-only placeholder; never reuse in production.
APP_SECRET=CHANGE_ME_LOCAL_SECRET

# PORT: host port mapped to :80 in the container (http://localhost:PORT).
PORT=8056
# DEFAULT_URI: base URL used to generate absolute URLs in non-HTTP contexts (CLI commands, mails).
DEFAULT_URI=http://localhost:8056

# DATABASE_URL: MySQL on the compose network (service `mysql`, no host ports — REQ-DEMO-006).
DATABASE_URL="mysql://app:app@mysql:3306/site_backup_demo?serverVersion=8.4.0&charset=utf8mb4"
