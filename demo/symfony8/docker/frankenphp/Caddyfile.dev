{
	order mercure after encode
	skip_install_trust
	# REQ-RUNTIME-001 timeout hierarchy: process_timeout (300 s, config/packages/nowo_site_backup.yaml)
	# < PHP max_execution_time (360 s) < Caddy write timeout (400 s).
	servers {
		timeouts {
			write 400s
		}
	}
	frankenphp {
		php_ini max_execution_time 360
		php_ini max_input_time 360
		# Cap how long a request waits for a free PHP thread (504 instead of an endless queue).
		max_wait_time 30s
	}
}

:80 {
	root * /app/public
	encode zstd br gzip
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header Pragma "no-cache"
	mercure {
		anonymous
	}

	php_server {
		hot_reload
	}
}
